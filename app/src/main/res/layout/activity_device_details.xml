<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/details_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/appBackground"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="22dp">

            <TextView
                android:id="@+id/back_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/appIconBackground"
                android:contentDescription="Back"
                android:gravity="center"
                android:text="‹"
                android:textColor="?attr/appText"
                android:textSize="34sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device details"
                    android:textColor="?attr/appText"
                    android:textSize="27sp"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/detail_device_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No device selected"
                    android:textColor="?attr/appTextSoft"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/appSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Earbuds"
                    android:textColor="?attr/appText"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/detail_connection_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Disconnected"
                    android:textColor="?attr/appTextSoft"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/detail_data_receiving_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/appSurfaceSmall"
                android:paddingStart="11dp"
                android:paddingTop="7dp"
                android:paddingEnd="11dp"
                android:paddingBottom="7dp"
                android:text="OFF"
                android:textColor="?attr/appTextFaint"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:layout_marginBottom="10dp"
            android:text="Battery"
            android:textColor="?attr/appText"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                android:background="?attr/appGaugeBackground"
                android:orientation="vertical"
                android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEFT" android:textColor="?attr/appTextFaint" android:textSize="10sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/detail_left_battery_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressDrawable="?attr/appProgressDrawable" />
                <TextView android:id="@+id/detail_left_battery_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="—" android:textColor="?attr/appText" android:textSize="18sp" />
            </LinearLayout>

            <Space android:layout_width="9dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                android:background="?attr/appGaugeBackground"
                android:orientation="vertical"
                android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RIGHT" android:textColor="?attr/appTextFaint" android:textSize="10sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/detail_right_battery_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressDrawable="?attr/appProgressDrawable" />
                <TextView android:id="@+id/detail_right_battery_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="—" android:textColor="?attr/appText" android:textSize="18sp" />
            </LinearLayout>

            <Space android:layout_width="9dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="118dp"
                android:layout_weight="1"
                android:background="?attr/appGaugeBackground"
                android:orientation="vertical"
                android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CASE" android:textColor="?attr/appTextFaint" android:textSize="10sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/detail_case_battery_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressDrawable="?attr/appProgressDrawable" />
                <TextView android:id="@+id/detail_case_battery_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="—" android:textColor="?attr/appText" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Features"
            android:textColor="?attr/appText"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/appSurface"
            android:orientation="vertical"
            android:padding="17dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find my earbuds" android:textColor="?attr/appText" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Play a sound when protocol support is available" android:textColor="?attr/appTextFaint" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/appSurface"
            android:orientation="vertical"
            android:padding="17dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sound effects" android:textColor="?attr/appText" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Audio controls will be added after the device controls are mapped" android:textColor="?attr/appTextFaint" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/appSurface"
            android:orientation="vertical"
            android:padding="17dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Game mode" android:textColor="?attr/appText" android:textSize="15sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Low-latency control will be added with protocol support" android:textColor="?attr/appTextFaint" android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Device information"
            android:textColor="?attr/appText"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detail_info_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/appSurfaceSmall"
            android:fontFamily="monospace"
            android:padding="15dp"
            android:text="No device selected"
            android:textColor="?attr/appTextFaint"
            android:textSize="11sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
