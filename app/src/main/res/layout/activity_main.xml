<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/appBackground"
    android:clipToPadding="false"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Devices"
                    android:textColor="?attr/appText"
                    android:textSize="28sp"
                    android:textStyle="normal"
                    android:letterSpacing="-0.02" />
                <TextView
                    android:id="@+id/device_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="No device selected yet"
                    android:textColor="?attr/appText_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings_button"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="?attr/appIconBackground"
                android:gravity="center"
                android:text="⚙"
                android:textColor="?attr/appText"
                android:textSize="21sp"
                android:contentDescription="Settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/device_details_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/appSurface"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="?attr/appIconBackground">
                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_buds_simple"
                        android:contentDescription="Earbuds" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Earbuds"
                        android:textColor="?attr/appText"
                        android:textSize="20sp"
                        android:textStyle="normal" />
                    <TextView
                        android:id="@+id/status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Disconnected"
                        android:textColor="?attr/appText_soft"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/choose_device_button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Pair device"
                    android:textAllCaps="false"
                    android:textColor="?attr/appText"
                    android:textSize="14sp"
                    android:background="?attr/appPrimaryButton"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <Space
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/start_service_button"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Start monitoring"
                    android:textAllCaps="false"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="?attr/appText"
                    android:textSize="13sp"
                    android:background="?attr/appSurface_button"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/data_receiving_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Data receiving: OFF"
            android:textColor="?attr/appText_faint"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            android:text="Battery"
            android:textColor="?attr/appText"
            android:textSize="16sp"
            android:textStyle="normal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="?attr/appGaugeBackground"
                android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LEFT" android:textColor="?attr/appText_faint" android:textSize="10sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/left_battery_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="11dp" android:max="100" android:progress="0" android:progressDrawable="?attr/appProgressDrawable" />
                <TextView android:id="@+id/left_battery_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="?attr/appText" android:textSize="16sp" />
            </LinearLayout>

            <Space android:layout_width="9dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="?attr/appGaugeBackground"
                android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RIGHT" android:textColor="?attr/appText_faint" android:textSize="10sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/right_battery_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="11dp" android:max="100" android:progress="0" android:progressDrawable="?attr/appProgressDrawable" />
                <TextView android:id="@+id/right_battery_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="?attr/appText" android:textSize="16sp" />
            </LinearLayout>

            <Space android:layout_width="9dp" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="108dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="?attr/appGaugeBackground"
                android:padding="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CASE" android:textColor="?attr/appText_faint" android:textSize="10sp" android:textStyle="bold" />
                <ProgressBar android:id="@+id/case_battery_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:layout_marginTop="11dp" android:max="100" android:progress="0" android:progressDrawable="?attr/appProgressDrawable" />
                <TextView android:id="@+id/case_battery_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="—" android:textColor="?attr/appText" android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="?attr/appSurface"
            android:padding="17dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Find my earbuds" android:textColor="?attr/appText" android:textSize="15sp" android:textStyle="normal" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Play a sound when protocol support is available" android:textColor="?attr/appText_faint" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIVE" android:textColor="?attr/appAccent" android:textSize="10sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="27dp" android:text="Diagnostics" android:textColor="?attr/appText" android:textSize="16sp" android:textStyle="normal" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="?attr/appSurfaceSmall" android:padding="14dp" android:text="Push subscription status" android:textColor="?attr/appText_soft" android:textSize="12sp" />
        <TextView android:id="@+id/debug_status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="-1dp" android:background="?attr/appSurfaceSmall" android:padding="14dp" android:fontFamily="monospace" android:text="Subscription acknowledged: no&#10;Received a pushed update: no" android:textColor="?attr/appText_faint" android:textSize="11sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="?attr/appSurfaceSmall" android:padding="14dp" android:text="Raw data received" android:textColor="?attr/appText_soft" android:textSize="12sp" />
        <TextView android:id="@+id/debug_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="?attr/appSurfaceSmall" android:padding="14dp" android:fontFamily="monospace" android:text="(no data received from buds yet)" android:textColor="?attr/appText_faint" android:textSize="10sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
